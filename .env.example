# Copy to .env (never commit .env). One file is shared by the API, the worker and the frontend.

# --- Backend / worker ---
# Local values match docker-compose.yml. Managed Postgres URLs (postgres:// or postgresql://) are fine as-is.
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 (::1) first, where Docker is not
# listening, and every connection then waits out its whole connect timeout before falling back to IPv4.
DATABASE_URL=postgresql://audio:audio@127.0.0.1:5432/audio_notes
REDIS_URL=redis://127.0.0.1:6379/0
# Provider keys are needed by the WORKER only. The API starts without them; the worker refuses to start if
# either is blank.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
# Summaries use Groq's OpenAI-compatible API. Get a key at https://console.groq.com/keys (worker only; never the browser).
LLM_API_KEY=

# --- Object storage (private AWS S3 bucket) ---
# Use the full bucket name; for an account-regional bucket that includes the -<account-id>-<region>-an suffix.
# Leave STORAGE_ENDPOINT empty for AWS; set it only for another S3-compatible store.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Transcription worker (optional; these are the defaults) ---
# GNANI_POLL_SECONDS=10                  # seconds between status polls; Gnani asks for no faster than 10
# GNANI_MIN_CALL_INTERVAL_SECONDS=1.2    # Gnani allows ~1 call/s per key; the client spaces its calls at least this far apart
# GNANI_MAX_TRANSCRIBE_SECONDS=7200      # give up on a job Gnani never finishes (fails as a timeout, retryable)
# GNANI_SOURCE_URL_EXPIRES_SECONDS=3600  # lifetime of the signed download link handed to Gnani

# --- Summary (optional; these are the defaults) ---
# LLM_MODEL=qwen/qwen3.8-27b        # llama-3.3-70b-versatile is not available to every key; list yours: GET /models
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MAX_OUTPUT_TOKENS=900         # cap on one answer. Groq limits OUTPUT tokens per minute (1000 on ours), so keep it below that;
#                                   # a cut-off answer is retried once with a request to be much shorter
# LLM_CHUNK_CHARS=6000              # a transcript longer than this is summarised in parts, then merged
# LLM_CHUNK_INTERVAL_SECONDS=30     # pause between parts, to stay under Groq's tokens-per-minute limit (on ours 8000 total and 1000 output tokens a minute; see your Groq limits page)
# LLM_MAX_WAIT_SECONDS=30           # a longer retry-after fails the job as rate limited instead of blocking a worker

# --- Upload limits (optional; these are the defaults) ---
# MAX_UPLOAD_BYTES=2147483648        # 2 GiB. One presigned PUT can carry at most 5 GB.
# UPLOAD_URL_EXPIRES_SECONDS=900     # S3 checks expiry when the upload request starts, not when it ends.
# AUDIO_RETENTION_SECONDS=7200       # a recording is deleted from storage this long after its upload began (minimum 60).
#                                    # The transcript and summary stay. Locally the Celery worker does it; deployed, Cloud Tasks does.

# --- Deployed on Google Cloud (leave unset locally; deploy/gcp.sh sets these on Cloud Run, see README "Deploy") ---
# NEON_DATABASE_URL=postgresql://...     # read only by deploy/gcp.sh, which stores it as the Secret Manager secret database-url
# QUEUE_BACKEND=celery                   # "cloudtasks" in production: Cloud Tasks replaces Redis and the Celery worker
# SERVICE_ROLE=api                       # "steps" makes this process the private step service (POST /internal/steps) instead
# CLOUD_TASKS_QUEUE=projects/<project>/locations/<region>/queues/job-steps   # cloudtasks only, as are the next two
# STEPS_URL=https://steps-<project-number>.<region>.run.app                  # the step service, no path
# STEPS_INVOKER_EMAIL=steps-sa@<project>.iam.gserviceaccount.com             # the account Cloud Tasks signs its calls as
# MAX_UPLOADS_PER_DAY=0                  # per browser per 24 h; 0 = no limit (the public demo uses 5)
# DB_CONNECT_TIMEOUT_SECONDS=3           # 10 for Neon, whose database sleeps when idle and wakes slowly

# --- Frontend / CORS ---
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Read by Next.js; it is public (bundled into browser code), so it must never hold a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Where /architecture links to (public). Defaults to this project's repository.
# NEXT_PUBLIC_GITHUB_URL=https://github.com/Am1n1602/Audio-notes-app

# --- Optional ---
APP_ENV=development
LOG_LEVEL=INFO
